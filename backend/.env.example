# Porta local (o Railway define PORT automaticamente em produção)
PORT=3000

# Qualquer string longa e aleatória — o app Android envia o mesmo valor no
# header X-App-Secret. Evita que estranhos usem seu backend.
APP_SHARED_SECRET=defina_um_segredo_forte_aqui

# JSON da conta de serviço do Firebase (Firebase Console > Configurações do
# projeto > Contas de serviço > Gerar nova chave privada), codificado em
# base64 em uma única linha: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=cole_aqui_o_json_em_base64

# Não há mais RAPIDAPI_KEY: os dados de jogos vêm da API pública do Sofascore
# (api.sofascore.com), sem chave — veja backend/src/footballApi.js.
